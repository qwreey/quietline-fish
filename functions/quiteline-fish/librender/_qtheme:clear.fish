function _qtheme:clear
    # Current flag
    set --global _qtheme_var_curr_topcolor ""
    set --global _qtheme_var_curr_toplen "0"

    # final output
    set --global _qtheme_var_result ""
    set --global _qtheme_var_content ""
    set --global _qtheme_var_topline ""
    set --global _qtheme_var_prompt ""
end
